# Las variables del entorno tienen prioridad sobre .env.
PROXY_HOST=0.0.0.0
PROXY_PORT=10800
# Máxima inactividad al leer del proveedor; no limita la duración total del stream.
REQUEST_TIMEOUT_SECONDS=120

# OpenCode Zen y Go comparten la misma clave de proveedor.
# El proxy acepta cualquier clave de cliente; no la reenvía al proveedor.
OPENCODE_API_KEY=
OPENCODE_ZEN_ENABLED=false
OPENCODE_GO_ENABLED=true
OPENCODE_CLIENT_VERSION=2.0.26
# OPENCODE_PROJECT_ID=
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o-mini,gpt-4o

# Protocolos de modelos nuevos sin recompilar: chat, messages, responses.
# Claves: ID completo con conector, o ID del proveedor.
# JSON entre comillas simples en .env.
# MODEL_PROTOCOL_OVERRIDES='{"opencode-go/modelo-nuevo":"responses"}'
RUST_LOG=info
