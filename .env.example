# Variables opcionales: omitirlas completamente para desactivar la opción.
# DATABASE_URL=postgres://usuario:clave@db.example:5432/proxy?sslmode=require
# DATABASE_URL=mysql://usuario:clave@db.example:3306/proxy?ssl-mode=REQUIRED
# DATABASE_URL=sqlite:///data/proxy.sqlite3
# AUTH_KEY=una-clave-compartida-larga
# PROXY_PUBLIC_URL=https://proxy.example.com
# PROXY_ADMIN_HOST=proxy.example.com

# Docker Compose: publicar en todas las interfaces del VPS si no hay reverse proxy.
# PROXY_BIND_ADDRESS=0.0.0.0
PROXY_EXPOSE_PORT=10800

# Ejecución nativa (Compose fija host, directorio y puertos internos).
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10800
# PROXY_ADMIN_PORT=10801
# PROXY_CONFIG_DIR=/ruta/persistente
RUST_LOG=info
# Los proveedores, modelos, límites y trazas se configuran desde el CLI.
# El servidor nativo no carga archivos .env: utiliza variables del proceso.
