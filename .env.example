# Copia este fichero a `.env` y rellena tus keys. Nunca lo subas a git.
#   Copy-Item .env.example .env   (PowerShell)
# El servidor lo carga solo al arrancar (flag --env para otra ruta).
# Las variables ya exportadas en el sistema tienen prioridad sobre el .env.

# OpenCode Zen (modelos gratuitos *-free y resto del catálogo Zen).
# Consíguela en https://opencode.ai/auth
OPENCODE_API_KEY=

# OpenAI (config.example.toml por defecto).
# OPENAI_API_KEY=

# Anthropic real (passthrough).
# ANTHROPIC_API_KEY=

# Token opcional para proteger tu proxy (debe coincidir con
# [server] auth_token del .toml si lo defines).
# PROXY_AUTH_TOKEN=
