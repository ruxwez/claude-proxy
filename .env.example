# claude-proxy — copia este fichero a `.env` y rellena tus keys.
#   Copy-Item .env.example .env   (PowerShell)
# Las variables ya exportadas en el sistema tienen prioridad sobre el .env.
# El servidor lo carga al arrancar (flag --env para otra ruta).

# --- Servidor ---
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
# Token opcional para proteger el proxy (x-api-key o Authorization: Bearer).
# PROXY_AUTH_TOKEN=
# Timeout (segundos) de cada llamada al proveedor.
REQUEST_TIMEOUT_SECONDS=120

# --- OpenCode (Zen y Go comparten la MISMA API key) ---
# Consíguela en https://opencode.ai/auth
OPENCODE_API_KEY=

# Conector Zen: solo expone los modelos gratuitos (IDs con "free").
OPENCODE_ZEN_ENABLED=true
# Conector Go: expone todo el catálogo de https://opencode.ai/zen/go/v1
OPENCODE_GO_ENABLED=false

# --- OpenAI genérico (opcional) ---
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Opcional: fija la lista de modelos (CSV) si tu proveedor no implementa /models.
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
